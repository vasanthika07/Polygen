# ==============================================================================
# PolyGen - Generative Text-to-3D Asset Pipeline Configuration Template
# ==============================================================================

# Core Application Settings
PROJECT_NAME="PolyGen - Generative Text-to-3D Asset Pipeline"
VERSION="1.0.0"
ENVIRONMENT="development" # development | staging | production
DEBUG=True

# Backend Server Configuration
HOST="127.0.0.1"
PORT=8000

# Security & Authentication (Generate using: openssl rand -hex 32)
SECRET_KEY="polygen-dev-super-secret-key-change-in-production-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (Async SQLite default for local run; PostgreSQL for production)
DATABASE_URL="sqlite+aiosqlite:///./polygen.db"
# Production PostgreSQL example:
# DATABASE_URL="postgresql+asyncpg://polygen_user:polygen_password@localhost:5432/polygen_db"

# Storage Settings
# STORAGE_BACKEND="local" or "s3"
STORAGE_BACKEND="local"
STORAGE_DIR="storage"

# S3 Configuration (when STORAGE_BACKEND="s3")
# S3_BUCKET_NAME="polygen-assets"
# AWS_ACCESS_KEY_ID="your-access-key-id"
# AWS_SECRET_ACCESS_KEY="your-secret-access-key"
# AWS_REGION="us-east-1"
# S3_ENDPOINT_URL=""

# AI Engine & Inference Placement
# AI_BACKEND="local_shape" | "procedural" | "remote_gpu"
AI_BACKEND="local_shape"
DEVICE="cpu" # cpu | cuda
TORCH_DTYPE="float32" # float32 | float16 | bfloat16
DEFAULT_POLYGON_BUDGET=10000
MAX_POLYGON_BUDGET=50000

# Redis & Celery Distributed Task Worker
REDIS_URL="redis://127.0.0.1:6379/0"
CELERY_BROKER_URL="redis://127.0.0.1:6379/0"
CELERY_RESULT_BACKEND="redis://127.0.0.1:6379/0"
CELERY_TASK_ALWAYS_EAGER=False

# Cross-Origin Resource Sharing (CORS)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:8000", "http://127.0.0.1:8000", "http://localhost:3000"]
