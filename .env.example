# PolyGen Environment Configuration
PROJECT_NAME="PolyGen - Generative Text-to-3D Asset Pipeline"
ENVIRONMENT=development
DEBUG=True

# Backend Server Configuration
HOST=127.0.0.1
PORT=8000
SECRET_KEY="polygen-dev-super-secret-key-change-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default for seamless local run, or PostgreSQL)
DATABASE_URL="sqlite+aiosqlite:///./polygen.db"
# DATABASE_URL="postgresql+asyncpg://polygen_user:polygen_pass@localhost:5432/polygen_db"

# Storage Directories
STORAGE_DIR="K:/Polygen/storage"
STORAGE_RAW_DIR="K:/Polygen/storage/raw"
STORAGE_PROCESSED_DIR="K:/Polygen/storage/processed"
STORAGE_TEXTURES_DIR="K:/Polygen/storage/textures"
STORAGE_EXPORTS_DIR="K:/Polygen/storage/exports"
STORAGE_PREVIEWS_DIR="K:/Polygen/storage/previews"

# AI Inference Engine Configuration
# Supported backends: 'local_shape', 'remote_gpu', 'mock'
AI_BACKEND="local_shape"
DEVICE="cpu"
TORCH_DTYPE="float32"
MAX_POLYGON_BUDGET=50000
DEFAULT_POLYGON_BUDGET=10000

# Redis / Celery (Optional for local async queue; required for distributed workers)
REDIS_URL="redis://localhost:6379/0"
CELERY_BROKER_URL="redis://localhost:6379/0"
CELERY_RESULT_BACKEND="redis://localhost:6379/0"

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000"]

